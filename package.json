{
  "name": "slm-business-layer",
  "version": "1.0.0",
  "description": "SLM-Powered Business Service Layer - A revolutionary web application architecture that replaces traditional custom-coded business service layers with a Small Language Model (SLM) driven system.",
  "main": "src/orchestration/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/orchestration/app.js",
    "dev": "nodemon src/orchestration/app.js",
    "dev:docker": "docker-compose --profile full up --build",
    "dev:services": "docker-compose -f docker-compose.simple.yml up -d",
    "dev:core": "docker-compose up -d ollama chromadb postgres redis",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/ config/ scripts/",
    "format:check": "prettier --check src/ config/ scripts/",
    "typecheck": "echo 'No TypeScript in this project'",
    "build": "echo 'No build step required'",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:up:full": "docker-compose --profile full up -d",
    "docker:up:simple": "docker-compose -f docker-compose.simple.yml up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "setup": "bash scripts/setup-local.sh",
    "init:rag": "python3 scripts/init-rag-db.py",
    "health": "curl -f http://localhost:8000/health || exit 1",
    "clean": "rm -rf node_modules logs/*.log data/app.db",
    "clean:docker": "docker-compose down -v && docker system prune -f",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "docker:reset": "docker-compose down -v --remove-orphans && docker network prune -f && docker volume prune -f"
  },
  "keywords": [
    "slm",
    "small-language-model",
    "business-logic",
    "rag",
    "retrieval-augmented-generation",
    "ollama",
    "chromadb",
    "api",
    "microservices",
    "ai",
    "machine-learning",
    "natural-language-processing"
  ],
  "author": "Claude Code",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.8.1",
    "jsonwebtoken": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "validator": "^13.9.0",
    "xss": "^1.0.14",
    "axios": "^1.4.0",
    "redis": "^4.6.7",
    "pg": "^8.11.1",
    "sqlite3": "^5.1.6",
    "chromadb": "^1.5.0",
    "mammoth": "^1.5.1",
    "pdf-parse": "^1.1.1",
    "dotenv": "^16.3.1",
    "express-async-errors": "^3.1.1",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "yaml": "^2.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^1.7.1",
    "prettier": "^3.0.0",
    "@types/node": "^20.4.5",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/**/*.spec.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:node/recommended",
      "plugin:security/recommended",
      "prettier"
    ],
    "plugins": [
      "security"
    ],
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "security/detect-object-injection": "warn",
      "node/no-missing-require": "error",
      "node/no-unpublished-require": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/slm-business-layer-proto.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/slm-business-layer-proto/issues"
  },
  "homepage": "https://github.com/your-org/slm-business-layer-proto#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/your-org"
  }
}